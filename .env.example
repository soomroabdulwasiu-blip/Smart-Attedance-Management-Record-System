# Documentation template only: current AMRS does not auto-load .env files.
# Prefer the one-time desktop Oracle setup; it encrypts credentials for this Windows user.
# Provide the password through a secure local environment. Never commit it.
AMRS_DB_USERNAME=AMRS
AMRS_ORACLE_DSN=localhost:1521/FREEPDB1
AMRS_DB_PASSWORD=
AMRS_REDUCE_MOTION=0


# Separate owner schema when using a runtime-only Oracle account:
AMRS_DB_SCHEMA=
# Migration CLI uses AMRS_MIGRATION_USER / AMRS_MIGRATION_DSN / AMRS_MIGRATION_PASSWORD.
# Supply their values securely; they are deliberately omitted here.
# Optional process overrides: AMRS_CONFIG_FILE, AMRS_DATA_DIR, AMRS_LOG_DIR,
# AMRS_POOL_MIN, AMRS_POOL_MAX, AMRS_FACE_THRESHOLD, AMRS_FACE_MARGIN and AMRS_QR_PORT.
# Secure QR settings can be saved in Teacher > QR Attendance > HTTPS setup.
# Process overrides: AMRS_QR_PUBLIC_HOST, AMRS_QR_CERT_FILE, AMRS_QR_KEY_FILE.
